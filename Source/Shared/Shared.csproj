<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<RootNamespace>Shared</RootNamespace>
		<Nullable>disable</Nullable>
		<LangVersion>12</LangVersion>
		<OutputPath>..\..\1.6\Assemblies</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Files\Network\**" />
	  <EmbeddedResource Remove="Files\Network\**" />
	  <None Remove="Files\Network\**" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="MessagePack" Version="3.1.4" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Newtonsoft.Json">
	    <HintPath>Assemblies\Newtonsoft.Json.dll</HintPath>
	  </Reference>
	</ItemGroup>
</Project>
